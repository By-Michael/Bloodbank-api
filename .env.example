# --- Database (your Render/hosted MySQL instance) ---
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_NAME=blood_donation_db
DB_USER=bloodbank_app
DB_PASSWORD=change_me
DB_SSL=true

# --- Auth ---
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h

# --- CORS ---
# Origins allowed to call this API. The desktop app doesn't need this (it's not a browser),
# but set it if you ever build a web frontend against the same API.
ALLOWED_ORIGINS=

# --- Server ---
PORT=3000
